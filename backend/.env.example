# =============================================
# SISTEMA DE ACTOS ADMINISTRATIVOS - BACKEND
# Copia este archivo a .env y completa los valores.
# NUNCA subir .env (credenciales reales) al repositorio.
# =============================================

# Cadena de conexión a PostgreSQL (Neon). Ej:
# postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Claves JWT (generar valores aleatorios largos)
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# Tiempos de expiración
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Entorno: development | test | production
ENVIRONMENT=development

# Seed inicial de SUPERADMIN (solo bootstrap; se borra en producción)
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NOMBRES=Super
SEED_SUPERADMIN_APELLIDOS=Administrador
SEED_SUPERADMIN_EMAIL=

# Retención de backups (días / semanas / meses)
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_RETENTION_MONTHS=6